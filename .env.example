# Configurações do servidor
PORT=5050
# Instalação sem Docker: 127.0.0.1 (padrão) = só este computador. Use 0.0.0.0
# apenas se outro aparelho da rede precisar acessar e proteja com firewall/HTTPS.
# No Docker este valor é ignorado (use BIND_ADDRESS abaixo).
# HOST=127.0.0.1
# Docker Compose: interface do host. Por padrão só o próprio host acessa.
BIND_ADDRESS=127.0.0.1

# Defina uma chave aleatória; scripts/setup.py gera uma ao criar .env.
# Nunca publique .env nem use chaves de exemplo.
API_KEY=
REQUIRE_API_KEY=True

# Padrões de síntese. Confirme a disponibilidade em VOICES.md/catálogo atual.
DEFAULT_VOICE=pt-BR-ThalitaMultilingualNeural
DEFAULT_RESPONSE_FORMAT=mp3
DEFAULT_SPEED=1.0

# False mantém a limpeza de emojis/Markdown; True envia texto sem esse filtro.
REMOVE_FILTER=False

# Limites por processo. Timeout cobre síntese e conversão.
MAX_INPUT_CHARS=10000
MAX_REQUEST_BYTES=131072
TTS_TIMEOUT_SECONDS=90
MAX_CONCURRENT_TTS=4

# Proxy de SAÍDA até Microsoft, opcional. Não é o Worker de entrada.
# PROXY=http://usuario:senha@host:porta

# Flags antigas DEFAULT_LANGUAGE, EXPAND_API e DETAILED_ERROR_LOGGING não são
# usadas pelo backend atual. Filtre vozes com a query locale ou multilingual.
